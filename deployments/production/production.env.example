# Single-tenant production profile.
# Copy to a private location, replace every changeme value, and do not commit secrets.

GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
GATEWAY_OTLP_GRPC_PORT=4317
GATEWAY_OTLP_HTTP_PORT=4318
GATEWAY_OTLP_MTLS_GRPC_PORT=4319
GATEWAY_HEALTH_PORT=13133
CONTROL_PLANE_PORT=8080
PLATFORM_UI_PORT=4173

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-grafana-password

CONTROL_PLANE_TENANT_ID=tenant-a
CONTROL_PLANE_OPERATOR_TOKEN=changeme-long-random-operator-token
PUBLIC_ENROLLMENT_ENDPOINT=http://localhost:8080
PUBLIC_CONTROL_PLANE_API_URL=http://localhost:8080
FRONTEND_CORS_ORIGIN=http://localhost:4173

GATEWAY_MEMORY_LIMIT_MIB=768
GATEWAY_MEMORY_SPIKE_LIMIT_MIB=192
GATEWAY_LOG_QUEUE_SIZE=10000
GATEWAY_TRACE_QUEUE_SIZE=10000

PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=20GB
TRACE_RETENTION_HOURS=168

GATEWAY_CERTS_HOST_PATH=/etc/otel-gateway/certs
GATEWAY_SECRETS_HOST_PATH=/etc/otel-gateway/secrets
GATEWAY_TLS_CERT_FILE=/tls/certs/gateway.crt
GATEWAY_TLS_KEY_FILE=/tls/secrets/gateway.key
GATEWAY_CLIENT_CA_FILE=/tls/certs/agent-ca-bundle.pem

ENROLLMENT_PKI_HOST_PATH=/etc/observability-platform/enrollment-pki
ENROLLMENT_CREDENTIALS_FILE=/var/lib/observability-platform/control-plane/enrollment-credentials.json
ENROLLMENT_REGISTRY_FILE=/var/lib/observability-platform/control-plane/agent-registry.json
ENROLLMENT_AUDIT_LOG=/var/lib/observability-platform/control-plane/audit.log
ENROLLMENT_ISSUER_MODE=external
ENROLLMENT_PRODUCTION_ISSUER_COMMAND=/tls/enrollment/issue-agent-certificate.sh
ENROLLMENT_PRODUCTION_ISSUER_CA_BUNDLE=/tls/enrollment/agent-ca-bundle.pem
ENROLLMENT_ALLOW_DEVELOPMENT_ISSUER=false
ENROLLMENT_DEVELOPMENT_AGENT_CA_CERT=/tls/enrollment/agent-ca.pem
ENROLLMENT_DEVELOPMENT_AGENT_CA_KEY=/tls/enrollment/agent-ca.key
ENROLLMENT_DEVELOPMENT_AGENT_CA_BUNDLE=/tls/enrollment/agent-ca-bundle.pem
ENROLLMENT_GATEWAY_CA_BUNDLE=/tls/enrollment/gateway-ca-bundle.pem
ENROLLMENT_AGENT_CERT_DAYS=60
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://localhost:3000
