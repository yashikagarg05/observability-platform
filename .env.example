# Local evaluation defaults for the base Docker Compose stack.
# Copy this file to .env before running the local demo:
#   cp .env.example .env

GRAFANA_PORT=3000
GRAFANA_BIND_ADDRESS=0.0.0.0
PROMETHEUS_PORT=9090
PROMETHEUS_BIND_ADDRESS=127.0.0.1

GRAFANA_ADMIN_USER=admin
# Development-only password. Use a strong secret for any shared or production host.
GRAFANA_ADMIN_PASSWORD=admin
