GATEWAY_OTLP_GRPC_ENDPOINT=central-collector.example.net:4317
AGENT_HOST_NAME=node-01
OTEL_SERVICE_NAMESPACE=applications
OTEL_DEPLOYMENT_ENVIRONMENT=production
NODE_AGENT_OTLP_GRPC_PORT=4317
NODE_AGENT_OTLP_HTTP_PORT=4318

# Optional mTLS transport. Leave unset for the current plaintext migration mode.
# Set NODE_AGENT_TRANSPORT_SUFFIX=-mtls and include config/compose/mtls.yaml
# after the selected source profile when mTLS certificates are installed.
# NODE_AGENT_TRANSPORT_SUFFIX=-mtls
# NODE_AGENT_CERTS_HOST_PATH=/etc/otel-node-agent/certs
# NODE_AGENT_SECRETS_HOST_PATH=/etc/otel-node-agent/secrets
# NODE_AGENT_TLS_CA_FILE=/tls/certs/ca-bundle.pem
# NODE_AGENT_TLS_CERT_FILE=/tls/certs/client.crt
# NODE_AGENT_TLS_KEY_FILE=/tls/secrets/client.key

# Required only with the docker-file profile.
# APP_LOG_HOST_PATH=/var/log/my-application
# APP_LOG_GLOB=*.log
# OTEL_SERVICE_NAME=my-application
